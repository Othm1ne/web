# Signs session cookies. Required in production (generate with: openssl rand -hex 32).
SESSION_SECRET=

# Postgres connection string (e.g. Supabase free tier, "Transaction pooler", port 6543).
# Leave unset locally to use the embedded PGlite database in data/pglite.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Lets `next start` use the embedded database without DATABASE_URL (local e2e only).
# ALLOW_EMBEDDED_DB=1

# Google sign-in. Redirect URI to register: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin, if it differs from the request's (e.g. behind a proxy).
# APP_URL=https://earrush.example.com

# Optional: iTunes storefront and the comma-separated artists shown as "Popular picks".
# MUSIC_COUNTRY=US
# FEATURED_ARTISTS=Daft Punk,Stromae
